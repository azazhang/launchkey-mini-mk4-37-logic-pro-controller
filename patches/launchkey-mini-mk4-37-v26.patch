+    lk37ForwardBurstCount=0
+  end
+  lk37LastScrubSign=sign
+  lk37LastScrubTime=now
+  if sign>0 then
+    lk37ForwardBurstCount=lk37ForwardBurstCount+1
+    if delta==1 and lk37ForwardBurstCount<=2 then return 2 end
+  end
