+-- Only wall-clock timing can distinguish this timer from unrelated host timers.
+-- Novation's stationary display text requires bit 6 on the field index
+-- to MAKE the stationary display visible. V17 cleared that bit for every
+-- clock feedback, causing a blank or title-less Transport display.
+-- During a foreground Position/Zoom/Scrub popup, defer that trigger so
+-- it does not prematurely interrupt the temporary display.
+function lk37HoldStationary(seconds)
+  local now=lk37DisplayNow()
+  lk37StationaryResumeAt=now and (now+seconds) or nil
+end
+function lk37CanTriggerStationary()
+  if encoderMode~=MODE.encoderTransport then return false end
+  if lk37StationaryResumeAt~=nil then
+    local now=lk37DisplayNow()
+    if now==nil or now<lk37StationaryResumeAt then return false end
+    lk37StationaryResumeAt=nil
+  end
+  return true
+end
+
+function lk37DisplayNow()
+  if type(os)=='table' and type(os.time)=='function' then
